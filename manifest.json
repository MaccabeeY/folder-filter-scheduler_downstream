{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.3.6.1",
  "author": "Kayhan",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "folder-filter-scheduler@kayhan.dev.tb128",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "messagesUpdate",
    "menus",
    "storage",
    "alarms",
    "notifications"
  ],
  "optional_permissions": ["addressBooks", "messagesTagsList"],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Rules",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
